{
  "schema_version": 2,
  "version": "2.0.0-alpha.1",
  "repository": "https://github.com/SnazzyGaz/creative-director",
  "kernel": {
    "always_on": [
      "AGENTS.md",
      "core/kernel.md"
    ],
    "token_budget": 1600,
    "notes": "Lean always-on kernel (<=1,600 tokens). Full core reference files and domain modules load on demand via cd.py load or cd.py rule <ID>."
  },
  "tiers": {
    "fast": {
      "label": "Tier 1: Fast QA",
      "when": "Routine edits, self-checks, consults, or quick fixes on existing work.",
      "roughs": [0, 0],
      "max_rounds": 2,
      "core_files": []
    },
    "directed": {
      "label": "Tier 2: Directed Creation",
      "when": "New visual pieces, open briefs, or variations.",
      "roughs": [2, 4],
      "recommended_roughs": 3,
      "max_rounds": 3,
      "core_files": [
        "core/creative-direction.md"
      ]
    },
    "remake": {
      "label": "Tier 3: Deep Remake",
      "when": "Explicit redo, rejig, start-over, or reimagine from scratch.",
      "roughs": [3, 6],
      "recommended_roughs": 4,
      "max_rounds": 5,
      "core_files": [
        "core/first-principles.md",
        "core/creative-direction.md"
      ]
    }
  },
  "core_files": [
    {"path": "AGENTS.md", "role": "entry", "always_on": true, "budget": 700},
    {"path": "core/kernel.md", "role": "always-on-kernel", "always_on": true, "budget": 1100},
    {"path": "core/principles.md", "role": "reference-principles", "always_on": false, "budget": 2800},
    {"path": "core/critique-loop.md", "role": "full-loop", "always_on": false, "budget": 3200},
    {"path": "core/critique-template.md", "role": "critique-template", "always_on": false, "budget": 1600},
    {"path": "core/creative-direction.md", "role": "directed-creation", "always_on": false, "budget": 2500},
    {"path": "core/first-principles.md", "role": "remake", "always_on": false, "budget": 4500},
    {"path": "core/energy-pass.md", "role": "intent-gated-energy", "always_on": false, "budget": 4500},
    {"path": "core/commands.md", "role": "nudges", "always_on": false, "budget": 2000},
    {"path": "core/brand-intake.md", "role": "brand-intake", "always_on": false, "budget": 1500},
    {"path": "core/evidence.md", "role": "evidence-and-myths", "always_on": false, "budget": 4500},
    {"path": "core/interaction-flow.md", "role": "flow-diagram", "always_on": false, "budget": 1500},
    {"path": "core/take-over.md", "role": "take-over", "always_on": false, "budget": 1000},
    {"path": "core/taste-profile.md", "role": "taste-separation", "always_on": false, "budget": 1500},
    {"path": "core/which-modules.md", "role": "routing-docs", "always_on": false, "budget": 4500}
  ],
  "hard_gates": [
    {"id": "CD-7", "scope": "all", "checkable": "code+visual", "summary": "Exact locked copy strings and fixed physical object counts"},
    {"id": "BRAND-4", "scope": "brand", "checkable": "code+visual", "summary": "Official marks placed unaltered from source file"},
    {"id": "BRAND-8", "scope": "all", "checkable": "visual", "summary": "No invented logos or garbled lettering"},
    {"id": "UI-6", "scope": "screen,fixed", "checkable": "code", "summary": "WCAG text contrast >= 4.5:1 (3:1 large text and UI boundaries)"},
    {"id": "UI-10", "scope": "screen", "checkable": "code", "summary": "Text scales to 200% without clipping or lost content"},
    {"id": "UI-11", "scope": "screen,fixed", "checkable": "visual", "summary": "No invented product screens in finished work"},
    {"id": "UX-1", "scope": "screen", "checkable": "interactive", "summary": "Primary user flow completes end to end"},
    {"id": "TYPE-3", "scope": "screen,fixed", "checkable": "code+visual", "summary": "Minimum readable type size respected"},
    {"id": "LAY-5", "scope": "fixed", "checkable": "code", "summary": "Text and key elements inside safe area"},
    {"id": "LAY-6", "scope": "fixed", "checkable": "visual", "summary": "Main message reads at feed/thumbnail size"},
    {"id": "LAY-9", "scope": "print", "checkable": "code", "summary": "Print bleed and >= 300 ppi at physical size"},
    {"id": "LAY-15", "scope": "fixed,screen", "checkable": "code", "summary": "Text over images passes contrast on worst ground pixels"},
    {"id": "LAY-19", "scope": "infographic", "checkable": "code", "summary": "Charts, maps and routes drawn accurately from data in code"},
    {"id": "INF-6", "scope": "infographic", "checkable": "visual", "summary": "Required and safety/medical steps survive accurately"},
    {"id": "CHAR-9", "scope": "people_or_animals", "checkable": "crop+visual", "summary": "2-4x cropped anatomy pass on every hand, limb, face and animal"},
    {"id": "CHAR-10", "scope": "people_or_animals", "checkable": "crop+visual", "summary": "Animal anatomy and part counts plausible"},
    {"id": "CHAR-11", "scope": "people_or_animals", "checkable": "crop+visual", "summary": "Props and gear match brief and connect physically"},
    {"id": "ILL-12", "scope": "illustration,photo", "checkable": "crop+visual", "summary": "Real subjects (especially food) physically plausible at 2-4x crop"},
    {"id": "TD-PER-1", "scope": "3d_space", "checkable": "code+visual", "summary": "Consistent single horizon and perspective"},
    {"id": "TD-LIT-1", "scope": "3d_space", "checkable": "visual", "summary": "Consistent single key light direction"},
    {"id": "3D-1", "scope": "3d", "checkable": "code", "summary": "3D mesh builds clean (intersections, manifold, normals)"},
    {"id": "FILM-ACC-1", "scope": "film", "checkable": "code+visual", "summary": "Video flash threshold safe (<= 3 large flashes/sec)"}
  ],
  "energy_triggers": [
    "energetic", "energy", "lively", "playful", "bold", "kinetic", "vibrant",
    "exciting", "dynamic", "festive", "celebration", "festival", "fete",
    "concert", "gig", "party", "carnival", "comedy", "children", "children's",
    "kids", "youth", "sport", "run", "race", "club", "nightlife", "loud",
    "punchy", "dramatic", "thriller", "action", "promotional", "campaign"
  ],
  "modules": {
    "layout": {
      "group": "core-visual",
      "summary": "Fixed frames: posters, covers, social cards, slides, print, signage, packaging and infographics. Infographic recipes are less mature until Batch 9 is judged.",
      "entry": "modules/layout/README.md",
      "extra_files": ["modules/layout/infographics.md"]
    },
    "typography": {
      "group": "core-visual",
      "summary": "Type choice, scale, measure, leading, display hierarchy and font selection.",
      "entry": "modules/typography/README.md",
      "extra_files": []
    },
    "composition": {
      "group": "core-visual",
      "summary": "Balance, visual weight, focus, unity, space and the pre-delivery Sitting right pass.",
      "entry": "modules/composition/README.md",
      "extra_files": ["modules/composition/sitting-right.md"]
    },
    "colour-value": {
      "group": "core-visual",
      "summary": "Value grouping, colour roles, neutral whites, simultaneous contrast and CVD safety.",
      "entry": "modules/colour-value/README.md",
      "extra_files": []
    },
    "illustration": {
      "group": "core-visual",
      "summary": "Picture-making, focal hierarchy, silhouettes, edges, storyboards and generated-image tells.",
      "entry": "modules/illustration/README.md",
      "extra_files": ["modules/illustration/notes.md"]
    },
    "character": {
      "group": "core-visual",
      "summary": "People, faces, hands, animals and props, including the CHAR-9 cropped anatomy delivery gate.",
      "entry": "modules/character/README.md",
      "extra_files": []
    },
    "technical-drawing": {
      "group": "core-visual",
      "summary": "Perspective, horizons, ellipses, proportion and consistent key lighting.",
      "entry": "modules/technical-drawing/README.md",
      "extra_files": []
    },
    "brand": {
      "group": "core-visual",
      "summary": "Official marks, brand systems, packaging identity and logo mark-making (LOGO-1..16).",
      "entry": "modules/brand/README.md",
      "extra_files": [
        "modules/brand/logo.md",
        "modules/brand/logo-notes.md",
        "modules/brand/mark-making.md",
        "modules/brand/clever-marks.md"
      ]
    },
    "photo": {
      "group": "core-visual",
      "summary": "Photographs and photoreal imagery: lens distance, camera height, light, casting and AI photo tells.",
      "entry": "modules/photo/README.md",
      "extra_files": []
    },
    "web-ui": {
      "group": "core-visual",
      "summary": "Web and app screens: layout grids, components, states, contrast, dark mode, reflow and motion. Less mature until Batch 9 (screens and infographics) is judged.",
      "entry": "modules/web-ui/README.md",
      "extra_files": ["modules/web-ui/notes.md"]
    },
    "ux": {
      "group": "core-visual",
      "summary": "Task flows, error recovery, defaults, keyboard focus order and alt text. Less mature until Batch 9 (screens and infographics) is judged.",
      "entry": "modules/ux/README.md",
      "extra_files": []
    },
    "aesthetic-critique": {
      "group": "core-visual",
      "summary": "Intent modelling, comparative pairwise verdicts, regression checks and novelty-typicality balance.",
      "entry": "modules/aesthetic-critique/README.md",
      "extra_files": []
    },
    "lookbook": {
      "group": "core-visual",
      "summary": "Optional 415 curated visual looks and clusters for controlled 20-50% style bleed on concepts/variations.",
      "entry": "modules/lookbook/README.md",
      "extra_files": []
    },
    "writing": {
      "group": "optional-domain",
      "summary": "Optional domain: website copy, emails, replies, blurbs, about pages and UI microcopy (WRITE-1..11).",
      "entry": "modules/writing/README.md",
      "extra_files": []
    },
    "film": {
      "group": "optional-domain",
      "summary": "Optional domain: cinematography, story beats, continuity, editing, grading, sound and generated-video QC.",
      "entry": "modules/film/README.md",
      "extra_files": [
        "modules/film/story.md",
        "modules/film/review.md",
        "modules/film/edit.md",
        "modules/film/generated.md",
        "modules/film/crossover.md",
        "modules/film/notes.md"
      ]
    },
    "3d": {
      "group": "optional-domain",
      "summary": "Optional domain: 3D models, renders, scene scale, build QA and Blender/AgX workflows.",
      "entry": "modules/3d/README.md",
      "extra_files": []
    }
  },
